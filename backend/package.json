{
  "name": "chatrat-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute CHATRAT_DB --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute CHATRAT_DB --remote --file=./schema.sql",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250321.0",
    "typescript": "^5.8.2",
    "wrangler": "^4.78.0"
  }
}
